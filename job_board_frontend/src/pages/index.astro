---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import JobList from '../components/JobList.astro';
import { getJobsFromMock } from '../lib/mockData';
import { getPublicEnv } from '../lib/types';

// Potential future API usage (not required now). We read PUBLIC_API_BASE without breaking if absent.
const env = getPublicEnv();

// Load jobs from mock for now.
// In a future enhancement, if env.PUBLIC_API_BASE is present and stable, we can fetch here instead.
const jobs = await getJobsFromMock();
---
<Layout title="Ocean Jobs — Find your next role">
  <Header />
  <main class="container" style="display:grid; gap: 16px; margin-top: 16px;">
    <SearchBar />
    <JobList jobs={jobs} />
  </main>
  <footer class="footer">
    © {new Date().getFullYear()} Ocean Jobs. All rights reserved.
  </footer>
</Layout>
